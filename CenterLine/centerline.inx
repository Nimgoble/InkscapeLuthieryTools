<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">

  <name>Center Line</name>
  <id>org.nim.center_line_extension</id>

  <label appearance="header">Things having to do with the center line</label>
  <param name="center_line_name" type="string" gui-text="Name of center line"></param>
  <param name="center_line_type" type="optiongroup" appearance="combo" gui-text="Center line type">
    <option value="1">Horizontal</option>
    <option value="2">Vertical</option>
  </param>
  
  <effect>
    <effects-menu>
      <submenu name="Luthiery Tools"/>
    </effects-menu>
  </effect>
  <script>
    <command location="inx" interpreter="python">centerline.py</command>
  </script>
</inkscape-extension>